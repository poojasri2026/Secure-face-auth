# =====================================================================
# Backend environment. Copy to `backend/.env` and fill in values.
# `.env` is git-ignored. NEVER commit real secrets.
# =====================================================================

# ---- Database (async driver) ----
# Local (no docker): use your local postgres host.
DATABASE_URL=postgresql+asyncpg://mfa:mfa@localhost:5432/mfa

# For dev convenience, create tables on startup without running Alembic.
# Set to false in production and use `alembic upgrade head` instead.
AUTO_CREATE_TABLES=true

# ---- JWT ----
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_access_secret
JWT_REFRESH_SECRET_KEY=CHANGE_ME_refresh_secret_different
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# HMAC pepper so stored OTP hashes are not plain SHA and can't be pre-computed.
OTP_PEPPER=CHANGE_ME_otp_pepper

# ---- Face / biometrics (thresholds are configurable here, not hard-coded) ----
FACE_MATCH_THRESHOLD=0.45
FACE_MIN_DET_SCORE=0.55
FACE_MIN_BOX_RATIO=0.10
FACE_ENROLL_MIN_SAMPLES=3
# InsightFace model pack (buffalo_l = ArcFace r100 + detector).
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_CTX_ID=-1
# Fernet key for encrypting embeddings at rest. If blank, a key is derived
# deterministically from JWT_SECRET_KEY (dev only; set a real key in prod).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_EMBEDDING_ENCRYPTION_KEY=

# ---- Liveness ----
LIVENESS_THRESHOLD=0.6
LIVENESS_CHALLENGE_COUNT=3
LIVENESS_SESSION_TTL_SECONDS=120
LIVENESS_PER_CHALLENGE_TIMEOUT_SECONDS=25
LIVENESS_MAX_FAILED_ATTEMPTS=3
# Signal thresholds used by server-side validation
EAR_CLOSED_THRESHOLD=0.20
EAR_OPEN_THRESHOLD=0.28
HEAD_YAW_THRESHOLD_DEG=18
HEAD_PITCH_THRESHOLD_DEG=14
HEAD_ROLL_THRESHOLD_DEG=14

# ---- SMTP (real email). Leave USERNAME/PASSWORD blank to log OTP to console. ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# ---- App / security ----
APP_NAME=Secure Face Auth
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
MAX_REQUEST_BYTES=8388608
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# ---- Bootstrap admin (created on first startup if it does not exist) ----
# Leave blank to skip. Use for the admin dashboard.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
