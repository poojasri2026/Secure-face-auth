# =====================================================================
# Root env used by docker-compose. Copy to `.env` and fill values.
# `.env` is git-ignored. NEVER commit real secrets.
# =====================================================================

# ---- Postgres (the compose "postgres" service reads these) ----
POSTGRES_USER=mfa
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mfa

# ---- Backend ----
# Inside docker-compose the DB host is the service name "postgres".
DATABASE_URL=postgresql+asyncpg://mfa:change-me-strong-password@postgres:5432/mfa

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-64-char-random-string
JWT_REFRESH_SECRET_KEY=replace-with-a-different-64-char-random-string
OTP_PEPPER=replace-with-random-string-used-to-hmac-otps

# Fernet key for encrypting face embeddings at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_EMBEDDING_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Biometrics thresholds (configurable, NOT hard-coded in code) ----
FACE_MATCH_THRESHOLD=0.45
LIVENESS_THRESHOLD=0.6

# ---- SMTP (real email). If unset/blank, OTPs are printed to backend console. ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---- CORS: comma-separated origins allowed to call the API ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Secure Face Auth
APP_NAME=Secure Face Auth
